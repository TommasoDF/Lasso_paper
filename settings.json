{
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-manuscript",
      "command": "latexmk",
      "args": [
        "-pdf",
        "-interaction=nonstopmode",
        "-halt-on-error",
        "-cd",
        "-outdir=../Manuscript",
        "-auxdir=../Manuscript",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk → Manuscript",
      "tools": ["latexmk-manuscripts"]
    }
  ],
  "latex-workshop.latex.defaultRecipe": "latexmk → Manuscript",
  "python.analysis.extraPaths": [
    "./Empirical/estimation"
  ],
  "latex-workshop.latex.clean.enabled": true,
  "latex-workshop.latex.clean.fileTypes": [
    "*.aux","*.bbl","*.blg","*.bcf","*.run.xml","*.toc","*.out","*.log","*.fls","*.fdb_latexmk","*.synctex.gz"
  ]
}
